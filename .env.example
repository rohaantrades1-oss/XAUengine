# Twelve Data: comma-separated keys, e.g. key1,key2,key3,...
TWELVE_DATA_API_KEYS=
TWELVE_DATA_SYMBOL=XAU/USD

# Telegram BotFather token
TELEGRAM_BOT_TOKEN=
# Optional: /start or /auto can bind the active chat automatically
TELEGRAM_CHAT_ID=

# Execution TF: 1min, 5min, 15min, 1h
EXECUTION_TF=5min

# Strategy thresholds
PIVOT_LEFT=3
PIVOT_RIGHT=3
OB_MAX_BASE_CANDLES=4
OB_MIN_DISPLACEMENT_ATR=1.2
FIB_TOLERANCE_ATR=0.20
MIN_RR=2.0

# Live polling
POLL_SECONDS=30
CANDLES_PER_REQUEST=300
